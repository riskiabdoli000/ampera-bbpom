// Prisma Schema untuk AMPERA-BBPOM
// Portal Pelayanan Publik & Pengujian Cepat BBPOM di Palembang

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusPengajuan {
  MENUNGGU_VERIFIKASI
  DIPROSES
  SELESAI
  DITOLAK
}

enum RoleAdmin {
  SUPERADMIN
  OPERATOR
}

enum TipePenerimaWa {
  TAMU
  PETUGAS
}

enum StatusNotifikasiWa {
  TERKIRIM
  GAGAL
  MENUNGGU
}

// Model Data Tamu / Pemohon (Kunci integrasi dengan Buku Tamu via NIK)
model Tamu {
  id           Int                @id @default(autoincrement())
  nik          String             @unique // 16 digit NIK KTP
  nama         String
  email        String?
  telepon      String?            // Nomor WhatsApp
  alamat       String?            // Domisili pemohon
  asalInstansi String?            // Nama Instansi / Kampus / Asal Organisasi (Layanan 1)
  umur         Int?               // Usia pemohon (Layanan 1)

  pengajuan    PengajuanLayanan[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([nik])
  @@index([telepon])
}

// Master 4 Layanan Resmi Ampera-BBPOM
// 1. INFO: Layanan Permintaan Informasi
// 2. UJI_CEPAT: Layanan Pengujian Cepat Ampera
// 3. ADUAN: Layanan Pengaduan
// 4. KIP: Layanan Keterbukaan Informasi Publik
model Layanan {
  id          Int                @id @default(autoincrement())
  kode        String             @unique // "INFO", "UJI_CEPAT", "ADUAN", "KIP"
  nama        String             @unique
  deskripsi   String?
  isAktif     Boolean            @default(true)

  pengajuan   PengajuanLayanan[]
  petugas     Petugas[]          // Daftar petugas yang ditugaskan pada layanan ini
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Transaksi Pengajuan Layanan Masyarakat
model PengajuanLayanan {
  id                  Int             @id @default(autoincrement())
  kodePengajuan       String          @unique // Cth: "AMP-INF-202610-0001", "AMP-UJI-202610-0001"
  
  tamuId              Int
  tamu                Tamu            @relation(fields: [tamuId], references: [id], onDelete: Cascade)
  
  layananId           Int
  layanan             Layanan         @relation(fields: [layananId], references: [id])
  
  status              StatusPengajuan @default(MENUNGGU_VERIFIKASI)
  catatanPetugas      String?         // Tanggapan atau hasil pemeriksaan dari petugas BBPOM
  
  // Field Spesifik Layanan 1 (Permintaan Informasi)
  informasiDibutuhkan String?         @db.Text
  kategoriInformasi   String?
  
  // Field Spesifik Layanan 2 (Pengujian Cepat Ampera)
  // Menyimpan jenis produk yang dicurigai: "Pempek, tekwan, model", "Tahu", "Mie basah", dsb.
  produkDicurigai     String?         // Dapat menyimpan nilai terpilih atau format JSON array
  produkLainnya       String?         // Isian jika memilih "Yang lain"
  alasanKecurigaan    String?         // "Produk tahan lama", "Perbedaan tekstur/rasa/bau", dsb.
  alasanLainnya       String?         // Isian jika memilih "Yang lain"
  rincianProduk       String?         @db.Text // Lokasi pasar, warung, penjual, tanggal pembelian
  
  // Field Spesifik Layanan 3 (Pengaduan) & Layanan 4 (Keterbukaan Informasi Publik)
  isiPengaduan        String?         @db.Text
  buktiFotoUrl        String?         @db.Text // URL foto bukti di Supabase storage
  ktpUrl              String?         @db.Text // URL scan / foto KTP di Supabase storage
  dokumenPendukungUrl String?         @db.Text // URL dokumen formulir PDF (Layanan KIP)
  
  // Field Spesifik Layanan 4 (Keterbukaan Informasi Publik)
  rincianInformasiKip String?         @db.Text
  tujuanPenggunaanKip String?         @db.Text
  
  // Petugas yang memverifikasi
  verifikatorId       Int?
  verifikator         Admin?          @relation(fields: [verifikatorId], references: [id])

  // Bukti Lampiran Tindakan Petugas BBPOM (Minimal 2 berkas, dinamis)
  lampiranTindakan    LampiranTindakanPetugas[]

  // Riwayat Pengiriman Notifikasi WhatsApp (Tamu & Petugas)
  notifikasiWa        NotifikasiWaLog[]

  // Survei Kepuasan Masyarakat (IKM)
  survei              SurveiLayanan?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([kodePengajuan])
  @@index([tamuId])
  @@index([layananId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Bukti Lampiran Tindakan Petugas BBPOM (Foto Hasil Uji, Dokumen BAP, Tanggapan Resmi, dsb.)
model LampiranTindakanPetugas {
  id          Int              @id @default(autoincrement())
  pengajuanId Int
  pengajuan   PengajuanLayanan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  url         String           @db.Text // URL publik berkas di Supabase Storage / Local
  storagePath String           @db.Text // Path unik di bucket storage untuk kebutuhan penghapusan
  namaFile    String           // Nama file asli (misal: "Hasil_Uji_Strip_Boraks.jpg")
  tipeFile    String           // MIME type (image/jpeg, image/png, application/pdf, etc.)
  ukuranFile  Int?             // Ukuran file dalam bytes

  createdAt   DateTime         @default(now())

  @@index([pengajuanId])
}

// Riwayat Pengiriman Notifikasi WhatsApp (Dual-Recipient: Tamu & Petugas)
model NotifikasiWaLog {
  id            Int                @id @default(autoincrement())

  pengajuanId   Int?
  pengajuan     PengajuanLayanan?  @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  tipePenerima  TipePenerimaWa     // TAMU atau PETUGAS
  nomorTujuan   String             // Format 628xxxxxxxxxx
  namaPenerima  String             // Nama Tamu atau Nama Petugas
  pesan         String             @db.Text

  status        StatusNotifikasiWa @default(MENUNGGU)
  responGateway String?            @db.Text // Pesan error atau data respon gateway

  dikirimPada   DateTime           @default(now())
  createdAt     DateTime           @default(now())

  @@index([pengajuanId])
  @@index([nomorTujuan])
  @@index([status])
  @@index([createdAt])
}

// Survei Kepuasan Masyarakat (IKM) terhadap Pelayanan & Website AMPERA
model SurveiLayanan {
  id                     Int              @id @default(autoincrement())
  pengajuanId            Int              @unique // Mencegah 1 tiket mengisi survei berulang kali
  pengajuan              PengajuanLayanan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  // 1. Rating Bintang Keseluruhan (1 - 5)
  ratingBintang          Int

  // 2. Kategori Pelayanan Petugas
  kualitasPelayanan      Int              // 1 (Sangat Buruk) s/d 5 (Sangat Baik)
  manfaatPelayanan       Int              // 1 (Tidak Bermanfaat) s/d 5 (Sangat Bermanfaat)

  // 3. Kategori Sistem & Website AMPERA
  kualitasWebsite        Int              // 1 (Sangat Buruk) s/d 5 (Sangat Baik)
  manfaatWebsite         Int              // 1 (Tidak Bermanfaat) s/d 5 (Sangat Bermanfaat)

  // 4. Kritik & Saran Tambahan (Opsional)
  kritikSaran            String?          @db.Text

  createdAt              DateTime         @default(now())

  @@index([ratingBintang])
  @@index([createdAt])
}


// Akun Admin & Operator Petugas BBPOM
model Admin {
  id          Int                @id @default(autoincrement())
  username    String             @unique
  nama        String
  password    String             // Hashed password (bcrypt)
  role        RoleAdmin          @default(OPERATOR)
  isAktif     Boolean            @default(true)
  
  verifikasi  PengajuanLayanan[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Master Data Petugas Pelayanan BBPOM di Palembang
model Petugas {
  id        Int      @id @default(autoincrement())
  nip       String   @unique // Nomor Induk Pegawai (NIP)
  nama      String   // Nama Lengkap Petugas
  telepon   String?  // Nomor WhatsApp / Kontak
  jabatan   String?  // Jabatan / Posisi / Unit Kerja
  fotoUrl   String?  @db.Text // Foto Profil Petugas
  fotoPath  String?  @db.Text // Path berkas di storage
  isAktif   Boolean  @default(true)

  layananId Int?     // Ditugaskan pada Layanan tertentu (opsional)
  layanan   Layanan? @relation(fields: [layananId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nip])
  @@index([nama])
  @@index([layananId])
}

// ==========================================
// PENGATURAN KONTEN WEBSITE (WEBSITE SETTINGS)
// ==========================================

// 1. Hero Content Banner
model HeroKonten {
  id               Int      @id @default(1)
  judul            String   @db.Text
  subjudul         String   @db.Text
  ctaUtamaLabel    String
  ctaSekunderLabel String?  @default("")
  updatedAt        DateTime @updatedAt
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  title     String
  alt       String
  imageUrl  String   @db.Text // URL publik (Supabase Storage / local fallback)
  imagePath String?  @db.Text // Path di Supabase Storage untuk kebutuhan hapus
  isActive  Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([urutan])
}

// 2. Video Profil BBPOM
model VideoProfil {
  id         Int      @id @default(1)
  eyebrow    String   @default("VIDEO PROFIL")
  judul      String   @db.Text
  deskripsi  String   @db.Text
  youtubeUrl String   @db.Text // URL asli dari YouTube
  youtubeId  String   // ID hasil ekstraksi untuk embed
  updatedAt  DateTime @updatedAt
}

// 3. Kontak & Lokasi Kantor (sesuai ContactSection)
model KontakKantor {
  id             Int      @id @default(1)
  eyebrow        String   @default("CONTACT DETAIL")
  judul          String   @default("Visit Our Office")
  deskripsi      String   @db.Text
  labelSosmed    String   @default("Media Sosial Resmi BBPOM Palembang:")

  alamat         String   @db.Text
  email1         String
  email2         String?
  telepon        String
  whatsapp       String
  whatsappPesan  String   @default("Halo Admin BBPOM Palembang, saya ingin berkonsultasi.") @db.Text

  mapsEmbedUrl   String   @db.Text
  mapsLinkUrl    String   @db.Text

  instagramUrl   String?  @db.Text
  facebookUrl    String?  @db.Text
  tiktokUrl      String?  @db.Text
  threadsUrl     String?  @db.Text
  youtubeUrl     String?  @db.Text

  updatedAt      DateTime @updatedAt
}

// 4. Konten Edukasi Konsumen
model Edukasi {
  id          Int      @id @default(autoincrement())
  judul       String
  kategori    String   // obat, pangan, kosmetik, cek_klik
  ringkasan   String   @db.Text
  konten      String?  @db.Text
  imageUrl    String?  @db.Text
  imagePath   String?  @db.Text
  isPublished Boolean  @default(true)
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([urutan])
}

// ==========================================
// 5. FITUR GARDA AMPERA (PRE-TEST, MATERI & POST-TEST)
// ==========================================

enum TipeSoalGarda {
  PRE_TEST
  POST_TEST
  SEMUA
}

model GardaPeserta {
  id               Int            @id @default(autoincrement())
  nik              String         // 16 digit NIK
  nama             String
  tanggalTes       DateTime       @default(now())
  alamat           String         @db.Text
  usia             Int
  jenisKelamin     String         // "Laki-laki" | "Perempuan"
  pendidikan       String
  pekerjaan        String
  instansi         String
  
  // Hasil Ujian
  preTestScore     Int?
  postTestScore    Int?
  postTestAttempts Int            @default(1)
  isLulus          Boolean        @default(false)
  nomorSertifikat  String?        @unique
  tanggalLulus     DateTime?
  
  // Relasi Evaluasi
  evaluasi         GardaEvaluasi?
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([nik])
  @@index([isLulus])
  @@index([createdAt])
}

model GardaEvaluasi {
  id              Int          @id @default(autoincrement())
  pesertaId       Int          @unique
  peserta         GardaPeserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)

  ratingKemudahan Int          // 1 - 5
  ratingMateri    Int          // 1 - 5
  ratingSoal      Int          // 1 - 5
  ratingManfaat   Int          // 1 - 5
  kritikSaran     String?      @db.Text

  createdAt       DateTime     @default(now())

  @@index([pesertaId])
}

model GardaSoal {
  id           Int           @id @default(autoincrement())
  tipe         TipeSoalGarda @default(PRE_TEST)
  kategori     String        // Contoh: "Regulasi Obat", "Pangan Aman", "Bahan Berbahaya", "Kosmetik Aman"
  pertanyaan   String        @db.Text
  pilihanA     String        @db.Text
  pilihanB     String        @db.Text
  pilihanC     String        @db.Text
  pilihanD     String        @db.Text
  jawabanBenar String        // "A" | "B" | "C" | "D"
  penjelasan   String?       @db.Text
  urutan       Int           @default(0)
  isAktif      Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tipe])
  @@index([urutan])
  @@index([isAktif])
}

model GardaMateri {
  id          Int          @id @default(autoincrement())
  nomor       Int          @unique // 1, 2, 3
  judul       String
  ringkasan   String       @db.Text
  durasi      String       @default("7 Menit Belajar")
  pdfUrl      String?      @db.Text
  isAktif     Boolean      @default(true)
  slides      GardaSlide[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([nomor])
}

model GardaSlide {
  id        Int         @id @default(autoincrement())
  materiId  Int
  materi    GardaMateri @relation(fields: [materiId], references: [id], onDelete: Cascade)
  urutan    Int         // 1 - 5
  judul     String
  subjudul  String
  poin      String      @db.Text // JSON string array poin
  tips      String?     @db.Text
  badge     String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([materiId])
  @@index([urutan])
}
